<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluentFin.Dialogs.Views.EditImagesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Dialogs.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:FluentFin.Dialogs.ViewModels"
    x:Name="Page"
    Title="Edit Images"
    CloseButtonText="Close"
    IsSecondaryButtonEnabled="True"
    SecondaryButtonCommand="{x:Bind ViewModel.SwitchViewCommand}"
    SecondaryButtonCommandParameter="{x:Bind vm:EditImagesViewModelState.Display}"
    SecondaryButtonText="{x:Bind ViewModel.BackButtonText, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyleWithTitleBackground}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <cc:EmptyObjectToObjectConverter
            x:Key="ObjectToVisibilityConverter"
            EmptyValue="Collapsed"
            NotEmptyValue="Visible" />
        <Style x:Key="TileStyle" TargetType="Grid">
            <Setter Property="Padding" Value="8" />
            <Setter Property="RowSpacing" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
        <Style x:Key="ImageWellStyle" TargetType="Border">
            <Setter Property="Height" Value="180" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
        <Style x:Key="TileCaptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="TileIconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </ContentDialog.Resources>

    <ctk:SwitchPresenter
        Width="720"
        MinHeight="300"
        TargetType="vm:EditImagesViewModelState"
        Value="{x:Bind ViewModel.State, Mode=OneWay}">
        <ctk:Case IsDefault="True" Value="Display">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="Current images" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.SwitchViewCommand}"
                        CommandParameter="{x:Bind vm:EditImagesViewModelState.Search}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Find" />
                            <TextBlock Text="Search online" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,0,-12,0"
                    Padding="0,0,12,0">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageInfoEx">
                                <Grid Style="{StaticResource TileStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource ImageWellStyle}">
                                        <controls:LoadingImage Source="{x:Bind c:Converters.GetImage(Uri)}" Stretch="Uniform" />
                                    </Border>
                                    <Grid Grid.Row="1" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind ImageType}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock Style="{StaticResource TileCaptionStyle}" Visibility="{x:Bind Width, Converter={StaticResource ObjectToVisibilityConverter}}">
                                                <Run Text="{x:Bind Width}" /><Run Text=" × " /><Run Text="{x:Bind Height}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="Search for replacement"
                                            Command="{Binding ElementName=Page, Path=ViewModel.SearchCommand}"
                                            CommandParameter="{x:Bind}"
                                            Content="{ui:FontIcon Glyph=&#xE721;, FontSize=14}"
                                            Style="{StaticResource TileIconButtonStyle}"
                                            ToolTipService.ToolTip="Search for replacement" />
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.Name="Delete image"
                                            Command="{Binding ElementName=Page, Path=ViewModel.DeleteImageCommand}"
                                            CommandParameter="{x:Bind}"
                                            Content="{ui:FontIcon Glyph=&#xE74D;, FontSize=14}"
                                            Style="{StaticResource TileIconButtonStyle}"
                                            ToolTipService.ToolTip="Delete image" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinItemWidth="160"
                                MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </ctk:Case>
        <ctk:Case Value="Search">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Name"
                        Header="Source"
                        ItemsSource="{x:Bind ViewModel.ImageProviders, Mode=OneWay}"
                        PlaceholderText="Select a source"
                        SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="Type"
                        ItemsSource="{x:Bind ViewModel.ImageTypes, Mode=OneWay}"
                        PlaceholderText="Select a type"
                        SelectedItem="{x:Bind ViewModel.SelectedImageType, Mode=TwoWay}" />
                    <CheckBox
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Content="All languages"
                        IsChecked="{x:Bind ViewModel.IncludeAllLanguages, Mode=TwoWay}" />
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,0,-12,0"
                    Padding="0,0,12,0">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="jm:RemoteImageInfo">
                                <Grid Style="{StaticResource TileStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource ImageWellStyle}">
                                        <controls:LoadingImage Source="{x:Bind Url}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind ProviderName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock Style="{StaticResource TileCaptionStyle}" Visibility="{x:Bind Width, Converter={StaticResource ObjectToVisibilityConverter}}">
                                            <Run Text="{x:Bind Width}" /><Run Text=" × " /><Run Text="{x:Bind Height}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource TileCaptionStyle}" Visibility="{x:Bind CommunityRating, Converter={StaticResource ObjectToVisibilityConverter}}">
                                            <Run Text="★" /><Run Text="{x:Bind CommunityRating}" /><Run Text=" · " /><Run Text="{x:Bind VoteCount}" /><Run Text=" votes" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button
                                        Grid.Row="2"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ElementName=Page, Path=ViewModel.UpdateImageCommand}"
                                        CommandParameter="{x:Bind}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                                            <TextBlock Text="Use image" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinItemWidth="160"
                                MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

            </Grid>
        </ctk:Case>
        <ctk:Case Value="Loading">
            <Grid>
                <ProgressRing
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True" />
            </Grid>
        </ctk:Case>
    </ctk:SwitchPresenter>
</ContentDialog>
