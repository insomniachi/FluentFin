<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluentFin.Dialogs.Views.EditSubtitlesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Dialogs.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:FluentFin.Dialogs.ViewModels"
    x:Name="Page"
    Title="Edit Subtitles"
    CloseButtonText="Close"
    Style="{StaticResource DefaultContentDialogStyleWithTitleBackground}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <cc:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cc:EmptyCollectionToObjectConverter
            x:Key="EmptyToVisibleConverter"
            EmptyValue="Visible"
            NotEmptyValue="Collapsed" />
        <Style x:Key="RowCardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
        <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="SecondaryCaptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer Margin="0,0,-12,0" Padding="0,0,12,0">
        <StackPanel Width="720" Spacing="8">
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Current subtitles" />

            <TextBlock
                Margin="4,0,0,0"
                Style="{StaticResource SecondaryCaptionStyle}"
                Text="This item has no subtitles."
                Visibility="{x:Bind ViewModel.Subtitles, Converter={StaticResource EmptyToVisibleConverter}, Mode=OneWay}" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Subtitles, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="jm:MediaStream">
                        <Grid Style="{StaticResource RowCardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xED1E;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind DisplayTitle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}">
                                    <Run Text="{x:Bind Codec}" />
                                </TextBlock>
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Delete subtitle"
                                Command="{Binding ElementName=Page, Path=ViewModel.DeleteSubtitleCommand}"
                                CommandParameter="{x:Bind}"
                                ToolTipService.ToolTip="Delete subtitle"
                                Visibility="{x:Bind IsExternal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <TextBlock
                Margin="4,16,0,0"
                Style="{StaticResource SectionHeaderStyle}"
                Text="Search online" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{x:Bind ViewModel.Cultures, Mode=OneWay}"
                    PlaceholderText="Language"
                    SelectedItem="{x:Bind ViewModel.SelectedCulture, Mode=TwoWay}" />
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.SearchSubtitlesCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Find" />
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>
            </Grid>

            <ItemsRepeater Margin="0,4,0,0" ItemsSource="{x:Bind ViewModel.RemoteSubtitles, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="jm:RemoteSubtitleInfo">
                        <Grid Style="{StaticResource RowCardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}">
                                    <Run Text="{x:Bind Format}" /><Run Text=" · " /><Run Text="{x:Bind DownloadCount}" /><Run Text=" downloads" />
                                </TextBlock>
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionStyle}"
                                    Text="{x:Bind Comment}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{Binding ElementName=Page, Path=ViewModel.DownloadSubtitleCommand}"
                                CommandParameter="{x:Bind}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                                    <TextBlock Text="Download" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
