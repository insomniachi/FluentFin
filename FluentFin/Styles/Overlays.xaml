<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Scrims that sit between an arbitrary image / video frame and light foregrounds (icons, text).
        Surfaces using them must set RequestedTheme="Dark" so the foreground stays light.
        OverlayContrastTests (FluentFin.Core.Tests) checks these values against WCAG contrast
        (3:1 for icons, 4.5:1 for text) with a white image behind them, the worst case.
    -->

    <!--  Transport controls drawn over the video. Peak of the Jellyfin web OSD gradient: rgba(16 16 16 / 0.75)  -->
    <SolidColorBrush
        x:Key="PlayerControlsScrimBrush"
        Opacity="0.75"
        Color="#101010" />

    <!--  Same as the detail ribbon of the Jellyfin web client: rgb(32 32 32 / 0.8)  -->
    <SolidColorBrush
        x:Key="MediaInfoScrimBrush"
        Opacity="0.8"
        Color="#202020" />

</ResourceDictionary>
